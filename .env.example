#  authentication, and file storage (e.g. project screenshots, videos).
#
#  How to get these values:
#    1. Go to https://supabase.com and sign in
#    2. Create or select your project
#    3. Navigate to Project Settings → API
#    4. Copy the values below
#
#  Required: YES

NEXT_PUBLIC_SUPABASE_URL=https://wbuogvokjolphyrzriab.supabase.co/rest/v1/
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndidW9ndm9ram9scGh5cnpyaWFiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU1NzEyNDQsImV4cCI6MjEwMTE0NzI0NH0.bZIh8dTHeux8UgP5si_0vkBB_M4RQqvHNke76yi9kK0

