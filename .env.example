# ------------------------------------------------------------------------
#  MICROSOFT CLARITY — Session Analytics (OPTIONAL)
# ------------------------------------------------------------------------
#  Clarity provides heatmaps, session recordings, and user behavior
#  insights. Leave empty to disable.
#
#  How to get this value:
#    1. Go to https://clarity.microsoft.com
#    2. Create a new project
#    3. Copy the Project ID from the setup script
#
#  Required: NO
#  Default: (disabled when empty)

NEXT_PUBLIC_CLARITY_ID=

# ------------------------------------------------------------------------
#  GOOGLE ANALYTICS 4 — Traffic Analytics (OPTIONAL)
# ------------------------------------------------------------------------
#  Google Analytics 4 (GA4) for tracking page views, events, and
#  conversion metrics. Leave empty to disable.
#
#  How to get this value:
#    1. Go to https://analytics.google.com
#    2. Create a property and obtain the Measurement ID
#       Format: G-XXXXXXXXXX
#
#  Required: NO
#  Default: (disabled when empty)

NEXT_PUBLIC_GA_ID=

# ------------------------------------------------------------------------
#  PRODUCTION / DEPLOYMENT — Informational (OPTIONAL)
# ------------------------------------------------------------------------
#  Override the canonical site URL used by sitemap, metadata,
#  and OpenGraph tags. If not set, falls back to SITE_CONFIG.url
#  in src/lib/constants.ts.
#
#  Required: NO
#  Default: https://nirmaan.dev

NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------------------
#  GMAIL SMTP — Contact Form Email Delivery (REQUIRED FOR EMAIL)
# ------------------------------------------------------------------------
#  Use a Gmail App Password and do not commit real credentials.
#
#  Required: YES if you want the contact form to send email.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-nirmalporeddiwar@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
CONTACT_EMAIL=nirmalporeddiwar@gmail.com

# ------------------------------------------------------------------------
#  SERVER-SIDE SECRETS (FUTURE USE)
# ------------------------------------------------------------------------
#  Reserved for future server-only features (admin dashboard,
#  contact form email API, etc.).
#
#  SUPABASE_SERVICE_ROLE_KEY — Do NOT expose this to the browser.
#  Used only in server-side code / Route Handlers / Server Actions.
